        },
        "since": {
          "type": "integer",
          "minimum": 0
        },
        "until": {
          "type": "integer",
          "minimum": 0
        },
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "type": "object",
      "required": [
        "source",
        "operation",
        "query",
        "purpose",
        "fields",
        "since",
        "until",
        "maxResults"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "gmail"
        },
        "operation": {
          "const": "send"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "from": {
