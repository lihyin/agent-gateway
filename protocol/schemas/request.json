{
  "$id": "https://agent-gateway.invalid/protocol/v1/request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "operation",
    "query",
    "purpose",
    "fields",
    "since",
    "until",
    "maxResults"
  ],
  "properties": {
    "source": { "const": "gmail" },
    "operation": { "enum": ["search", "get"] },
    "query": { "type": "string", "minLength": 1, "maxLength": 200 },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["id", "date", "from", "subject", "snippet"] }
    },
    "since": { "type": "integer", "minimum": 0 },
    "until": { "type": "integer", "minimum": 0 },
    "maxResults": { "type": "integer", "minimum": 1, "maximum": 10 }
  }
}
