{
  "$id": "https://agent-gateway.invalid/protocol/v1/route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "audience",
    "agentId",
    "deviceId",
    "pairingEpoch",
    "pushToken",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "version": { "const": 1 },
    "audience": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 200
    },
    "agentId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "deviceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "pairingEpoch": { "type": "string", "format": "uuid" },
    "pushToken": { "type": "string", "pattern": "^[0-9a-f]{64,200}$" },
    "issuedAt": { "type": "integer", "minimum": 0 },
    "expiresAt": { "type": "integer", "minimum": 0 }
  }
}
